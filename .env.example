# Use the Core settings in scripts/.env.parking-operations and the Recognition
# settings in scripts/.env.recognition. See docs/operations/neon-microservices.md.
# Never commit .env or put real secrets in appsettings.json.

# Parking Core uses the existing smartparking database.
ConnectionStrings__DefaultConnection=

# Parking Operations owns its handover data in a separate PostgreSQL database.
ConnectionStrings__OperationsConnection=
CoreApi__BaseUrl=http://localhost:5295
Recognition__BaseUrl=

# Optional Google Sign-In OAuth client ID (Web application).
GoogleAuth__ClientId=

# Set the same internal key in both processes when using Recognition.
Recognition__InternalKey=

# Optional recognition database for the existing recognition feature.
ConnectionStrings__AiRecognitionConnection=

# FastAPI AI service
AiService__BaseUrl=http://localhost:8000/
AiService__MaxUploadSizeBytes=10485760

# Backend secrets required by local development
Jwt__SecretKey=replace-with-at-least-32-characters

# Optional Cloudinary settings
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
