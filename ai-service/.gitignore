# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & IDE
.env
.env.*
.venv
env/
venv/
ENV/
.vscode/
.idea/

# Large model weights (>50MB-100MB, keep in cloud storage or Git LFS)
