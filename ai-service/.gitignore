# weights/*.onnx
# weights/ppocrv4/*.onnx
# !weights/.gitkeep
# !weights/ppocrv4/.gitkeep

# Tracker checkpoints
tracking/deep_sort/deep/checkpoint/*.t7
tracking/deep_sort/deep/checkpoint/*.pb
!tracking/deep_sort/deep/checkpoint/.gitkeep

# Data & logs
data/
logs/
*.log
