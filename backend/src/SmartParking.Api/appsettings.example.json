{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartparking_dev;Username=postgres;Password=YOUR_DATABASE_PASSWORD"
  },
  "Jwt": {
    "Issuer": "SmartParkingApi",
    "Audience": "SmartParkingClient",
    "SecretKey": "YOUR_STRONG_JWT_SECRET_KEY_MIN_32_CHARACTERS",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Security": {
    "OtpSecretKey": "YOUR_STRONG_OTP_SECRET_KEY_MIN_32_CHARACTERS",
    "OtpLifetimeMinutes": 15,
    "MaxFailedOtpAttempts": 5,
    "OtpResendCooldownSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "Recaptcha": {
    "SecretKey": "",
    "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify",
    "MinScore": 0.5,
    "Enabled": false
  },
  "Email": {
    "Provider": "Mock",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "SenderEmail": "",
    "SenderName": "Smart Parking System"
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Username": "",
    "Email": "",
    "Password": "",
    "FullName": "System Administrator",
    "PhoneNumber": ""
  }
}
