<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>smart-parking-system-development</UserSecretsId>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../../frontend/smart-parking/</FrontendRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\parking-lots.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\frontend\3d-viewer.html" Link="wwwroot\3d-viewer.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\frontend\assets\**\*" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartParking.Application\SmartParking.Application.csproj" />
    <ProjectReference Include="..\SmartParking.Infrastructure\SmartParking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="$(FrontendRoot)src/**/*;$(FrontendRoot)public/**/*;$(FrontendRoot)index.html;$(FrontendRoot)package.json;$(FrontendRoot)package-lock.json;$(FrontendRoot)vite.config.*" Set="Frontend" />
    <UpToDateCheckOutput Include="$(MSBuildProjectDirectory)/wwwroot/app/index.html" Set="Frontend" />
  </ItemGroup>

  <Target Name="RestoreFrontendDependencies"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(FrontendRoot)package.json;$(FrontendRoot)package-lock.json"
          Outputs="$(FrontendRoot)node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci --include=dev --no-audit --no-fund" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild"
          DependsOnTargets="RestoreFrontendDependencies"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
    <ItemGroup>
      <Content Remove="wwwroot/app/**/*" />
      <Content Include="wwwroot/app/**/*" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
